---
import { Image } from "astro:assets";
import { menu } from "../data/menu";
import { getFoto } from "../data/images";
---

<section class="seccion menu" id="menu">
  <div class="contenedor">
    <span class="seccion__cinta">Menú</span>
    <h2 class="seccion__titulo">Lo que se antoja</h2>

    <p class="menu__lead">
      Precios de referencia. ¿Quieres ver la carta completa? <a href={`${import.meta.env.BASE_URL}carta`}
        >Ábrela en PDF</a
      >.
    </p>

    <nav class="menu__nav" aria-label="Categorías del menú">
      {
        menu.map((cat) => (
          <a href={`#${cat.id}`}>
            <span aria-hidden="true">{cat.emoji}</span> {cat.titulo}
          </a>
        ))
      }
    </nav>

    {
      menu.map((cat) => (
        <section class="categoria" id={cat.id} aria-labelledby={`${cat.id}-titulo`}>
          <h3 class="categoria__titulo" id={`${cat.id}-titulo`}>
            <span class="emoji" aria-hidden="true">
              {cat.emoji}
            </span>
            {cat.titulo}
          </h3>
          {cat.nota && <span class="categoria__nota">{cat.nota}</span>}

          <div class="items">
            {cat.items.map((item) => {
              const foto = getFoto(item.foto);
              const id = `${cat.id}::${item.nombre}`;
              return (
                <article
                  class="item"
                  data-id={id}
                  data-nombre={item.nombre}
                  data-precio={item.precio ?? ""}
                >
                  {foto && (
                    <Image
                      class="item__foto"
                      src={foto}
                      alt={item.nombre}
                      width={124}
                      height={124}
                      loading="lazy"
                      format="webp"
                    />
                  )}
                  <div class="item__texto">
                    <div class="item__nombre">{item.nombre}</div>
                    {item.descripcion && (
                      <p class="item__desc">{item.descripcion}</p>
                    )}
                  </div>
                  {item.precio && (
                    <div class="item__acciones">
                      <span class="item__precio">{item.precio}</span>
                      <button
                        class="item__add"
                        type="button"
                        data-add
                        aria-label={`Añadir ${item.nombre} al carrito`}
                      >
                        + Añadir
                      </button>
                    </div>
                  )}
                </article>
              );
            })}
          </div>
        </section>
      ))
    }
  </div>
</section>
