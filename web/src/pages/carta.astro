---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import WhatsAppFloat from "../components/WhatsAppFloat.astro";
import LibroCarta from "../components/LibroCarta.astro";
import { negocio } from "../data/menu";

const base = import.meta.env.BASE_URL;
const pdf = `${base}carta/carta.pdf`;
---

<BaseLayout titulo={`Carta — ${negocio.nombre}`}>
  <header class="carta-bar">
    <div class="contenedor carta-bar__inner">
      <a class="carta-bar__volver" href={base}>← Inicio</a>
      <span class="carta-bar__titulo">Nuestra carta</span>
      <a
        class="btn btn--rojo carta-bar__pdf"
        href={pdf}
        target="_blank"
        rel="noopener"
      >
        Abrir PDF
      </a>
    </div>
  </header>

  <main class="carta">
    <div class="contenedor">
      <span class="seccion__cinta">Carta</span>
      <h1 class="carta__titulo">Nuestra carta completa</h1>
      <p class="carta__lead">
        Hojea nuestra carta como un libro. Desliza, toca las esquinas o usa las
        flechas; también puedes abrir el PDF para hacer zoom o descargarla.
      </p>

      <div class="carta__acciones">
        <a class="btn btn--rojo" href={pdf} target="_blank" rel="noopener">
          Abrir en PDF
        </a>
        <a class="btn" href={pdf} download="Carta-Su-Punto-Para-Que-Coma.pdf">
          Descargar
        </a>
      </div>

      <LibroCarta />
    </div>
  </main>

  <Footer />
  <WhatsAppFloat />
</BaseLayout>

<style>
  .carta-bar {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(21, 21, 21, 0.94);
    backdrop-filter: blur(10px);
    border-bottom: var(--borde);
  }
  .carta-bar__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.6rem;
    padding-block: 0.6rem;
  }
  .carta-bar__volver {
    justify-self: start;
    font-family: var(--fuente-titulo);
    font-weight: 400;
    text-decoration: none;
    color: var(--tiza);
    background: transparent;
    border: var(--borde-fino);
    border-radius: 999px;
    padding: 0.32rem 0.9rem;
    font-size: 0.95rem;
  }
  .carta-bar__volver:hover {
    background: var(--amarillo);
    border-color: var(--amarillo);
    color: var(--negro);
  }
  .carta-bar__titulo {
    font-family: var(--fuente-titulo);
    font-weight: 400;
    letter-spacing: 0.02em;
    font-size: 1.12rem;
    color: var(--amarillo);
    text-align: center;
  }
  .carta-bar__pdf {
    justify-self: end;
    font-size: 0.9rem;
    padding: 0.45rem 0.95rem;
  }
  .carta-bar__inner .carta-bar__volver,
  .carta-bar__inner .carta-bar__pdf {
    white-space: nowrap;
  }

  .carta {
    background: transparent;
    padding-block: 1.6rem 3rem;
  }
  .carta__titulo {
    font-size: clamp(1.8rem, 7vw, 3rem);
    font-weight: 400;
    text-transform: uppercase;
    color: var(--tiza);
    text-shadow: 0 3px 0 rgba(0, 0, 0, 0.55);
    margin-bottom: 0.4rem;
  }
  .carta__lead {
    max-width: 44rem;
    font-weight: 600;
    color: var(--tiza-suave);
    margin-bottom: 1.1rem;
  }
  .carta__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-bottom: 0.4rem;
  }

  @media (min-width: 900px) {
    .carta {
      padding-block: 2.5rem 4rem;
    }
  }
</style>
